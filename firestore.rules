rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Quick Fix: Returns true to allow our custom login system to bypass the auth check
    function isAuthenticated() {
      return true;
    }
    
    // Settings Collection
    match /company_settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    
    // Products Collection
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }
    
    // Invoices / Bills Collection (Added bills to match the app code)
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }
    match /bills/{billId} {
      allow read, write: if isAuthenticated();
    }
    
    // Orders Collection (Added orders to match the app code)
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }
    
    // Customers Collection
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }
    
    // Users Collection
    match /users/{userId} {
      // Allow reading and writing for the custom login/signup flow
      allow read, write: if isAuthenticated();
    }
  }
}
